# ==============================================================================
# Bhasha Library — Environment Variables Template
# Copy this file to .env and fill in your actual credentials.
# NEVER commit your actual .env file to GitHub.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Firebase Configuration (Web Client SDK)
# Obtain from: Firebase Console -> Project Settings -> General -> Your Apps -> Web app
# ------------------------------------------------------------------------------
VITE_FIREBASE_API_KEY=your_firebase_api_key_here
VITE_FIREBASE_AUTH_DOMAIN=your_project_id.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your_project_id
VITE_FIREBASE_STORAGE_BUCKET=your_project_id.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id
VITE_FIREBASE_APP_ID=your_app_id

# ------------------------------------------------------------------------------
# 2. LLM / AI Model API Keys (For Author Studio Co-Scribe)
# Obtain from:
# - Google AI Studio (Gemini): https://aistudio.google.com/app/apikey
# - OpenAI: https://platform.openai.com/api-keys
# - Anthropic: https://console.anthropic.com/
# ------------------------------------------------------------------------------
VITE_GEMINI_API_KEY=your_gemini_api_key_here
VITE_OPENAI_API_KEY=your_openai_api_key_here
VITE_ANTHROPIC_API_KEY=your_anthropic_api_key_here
