rules_version = '2';

// ===============================================================
// Assumed Data Model
// ===============================================================
//
// This security rules file assumes the following data structures:
//
// Collection: manuscripts_catalog
// Document ID: {bookId} (e.g. 'gitanjali-1910', 'pather-panchali-1929', or unique ID)
// Fields:
//   - name: string (required, 1-200 chars) - Title of the literary manuscript/book
//   - author: string (required, 1-150 chars) - Author name in English and/or Bengali
//   - yearPublished: number (required, 1000-2100) - Year of original publication
//   - genre: string (required, 1-100 chars) - Literary genre classification
//   - pages: number (required, 1-10000) - Total manuscript folio count
//   - id: string (optional, 1-100 chars, immutable) - Slug identifier matching bookId
//   - decade: string (optional, 1-20 chars) - Historical publication decade (e.g. '1910s')
//   - isbn: string (optional, 1-50 chars) - Standard book number/archival identifier
//   - clicks: number (optional, >= 0) - Cached read count
//   - storageUrl: string (optional, 1-500 chars) - Archival digital folio URL or gs:// URI
//   - summary: string (optional, 0-5000 chars) - Literary synopsis and historical context
//   - coverColor: string (optional, 1-30 chars) - Hex or CSS theme color
//   - coverAccent: string (optional, 1-30 chars) - Hex or CSS accent color
//   - coverMotif: string (optional, 1-50 chars) - Cultural ornamental motif name
//   - pagesData: list (optional, max 1000 items) - Digitized pages/excerpts
//   - createdAt: timestamp (optional, immutable) - Initial creation timestamp
//   - updatedAt: timestamp (optional) - Last update timestamp
//
// Collection: reader_clicks
// Document ID: {clickDocId} (e.g. bookId or telemetry event ID)
// Fields:
//   - bookId: string (required, 1-100 chars, immutable) - Manuscript ID being tracked
//   - id: string (optional, 1-100 chars, immutable) - Telemetry document ID
//   - clicks: number (optional, >= 0) - Cumulative reader interaction count
//   - clickCount: number (optional, >= 0) - Alternative counter representation
//   - timestamp: timestamp (optional) - Telemetry record timestamp
//   - updatedAt: timestamp (optional) - Telemetry update timestamp
//   - lastClickedAt: timestamp (optional) - Latest reader interaction timestamp
//
// Collection: author_notes
// Document ID: {noteId} (unique note identifier)
// Fields:
//   - authorId: string (required if userId absent, 1-128 chars, immutable) - Author UID
//   - userId: string (required if authorId absent, 1-128 chars, immutable) - Alternate author UID
//   - id: string (optional, 1-128 chars, immutable) - Note ID matching docId
//   - noteId: string (optional, 1-128 chars, immutable) - Alternate note ID
//   - title: string (optional, 0-200 chars) - Research note heading
//   - content: string (optional, 0-50000 chars) - Markdown research notes body
//   - notes: string (optional, 0-50000 chars) - Running notes text
//   - bookId: string (optional, 1-100 chars) - Associated manuscript reference
//   - tags: list (optional, max 20 items) - Categorical research tags
//   - createdAt: timestamp (optional, immutable) - Note creation timestamp
//   - updatedAt: timestamp (optional) - Note modification timestamp
//   - lastSaved: timestamp (optional) - Autosave timestamp
//
// ===============================================================

service cloud.firestore {
  match /databases/{database}/documents {

    // ===============================================================
    // Core Helper Functions
    // ===============================================================

    // Check if the request is from an authenticated user
    function isAuthenticated() {
      return request.auth != null;
    }

    // Check if the authenticated user is the designated owner by UID
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // Validate that required fields exist in incoming data
    function hasRequiredFields(data, fields) {
      return data.keys().hasAll(fields);
    }

    // Validate that incoming data only contains allowed fields (Strict Schema Enforcement)
    function hasOnlyAllowedFields(data, allowedFields) {
      return data.keys().hasOnly(allowedFields);
    }

    // Validate a required string field with min and max size
    function isValidString(val, minLen, maxLen) {
      return val is string && val.size() >= minLen && val.size() <= maxLen;
    }

    // Validate an optional string field
    function isValidOptionalString(data, field, minLen, maxLen) {
      return !(field in data) ||
        (data[field] is string && data[field].size() >= minLen && data[field].size() <= maxLen);
    }

    // Validate an optional number field with bounds
    function isValidOptionalNumber(data, field, minVal, maxVal) {
      return !(field in data) ||
        (data[field] is number && data[field] >= minVal && data[field] <= maxVal);
    }

    // Validate an optional timestamp field
    function isValidOptionalTimestamp(data, field) {
      return !(field in data) || data[field] is timestamp;
    }

    // Validate an optional list field with maximum size
    function isValidOptionalList(data, field, maxSize) {
      return !(field in data) ||
        (data[field] is list && data[field].size() <= maxSize);
    }

    // ===============================================================
    // Domain Validators: manuscripts_catalog
    // ===============================================================

    function isValidManuscript(data) {
      let allowedFields = [
        'id', 'name', 'author', 'yearPublished', 'decade',
        'genre', 'pages', 'isbn', 'clicks', 'storageUrl',
        'summary', 'coverColor', 'coverAccent', 'coverMotif',
        'pagesData', 'createdAt', 'updatedAt'
      ];
      let requiredFields = ['name', 'author', 'yearPublished', 'genre', 'pages'];

      return hasRequiredFields(data, requiredFields) &&
             hasOnlyAllowedFields(data, allowedFields) &&
             isValidString(data.name, 1, 200) &&
             isValidString(data.author, 1, 150) &&
             data.yearPublished is number && data.yearPublished >= 1000 && data.yearPublished <= 2100 &&
             isValidString(data.genre, 1, 100) &&
             data.pages is number && data.pages > 0 && data.pages <= 10000 &&
             isValidOptionalString(data, 'id', 1, 100) &&
             isValidOptionalString(data, 'decade', 1, 20) &&
             isValidOptionalString(data, 'isbn', 1, 50) &&
             isValidOptionalNumber(data, 'clicks', 0, 1000000000) &&
             isValidOptionalString(data, 'storageUrl', 1, 500) &&
             isValidOptionalString(data, 'summary', 0, 5000) &&
             isValidOptionalString(data, 'coverColor', 1, 30) &&
             isValidOptionalString(data, 'coverAccent', 1, 30) &&
             isValidOptionalString(data, 'coverMotif', 1, 50) &&
             isValidOptionalList(data, 'pagesData', 1000) &&
             isValidOptionalTimestamp(data, 'createdAt') &&
             isValidOptionalTimestamp(data, 'updatedAt');
    }

    function areManuscriptImmutableFieldsUnchanged() {
      return (!('createdAt' in resource.data) ||
              ('createdAt' in request.resource.data && request.resource.data.createdAt == resource.data.createdAt)) &&
             (!('id' in resource.data) ||
              ('id' in request.resource.data && request.resource.data.id == resource.data.id));
    }

    // ===============================================================
    // Domain Validators: reader_clicks
    // ===============================================================

    function isValidClickTelemetry(data) {
      let allowedFields = ['id', 'bookId', 'clicks', 'clickCount', 'timestamp', 'updatedAt', 'lastClickedAt'];

      return hasOnlyAllowedFields(data, allowedFields) &&
             ('bookId' in data && isValidString(data.bookId, 1, 100)) &&
             (('clicks' in data && data.clicks is number && data.clicks >= 0) ||
              ('clickCount' in data && data.clickCount is number && data.clickCount >= 0)) &&
             isValidOptionalString(data, 'id', 1, 100) &&
             isValidOptionalNumber(data, 'clicks', 0, 1000000000) &&
             isValidOptionalNumber(data, 'clickCount', 0, 1000000000) &&
             isValidOptionalTimestamp(data, 'timestamp') &&
             isValidOptionalTimestamp(data, 'updatedAt') &&
             isValidOptionalTimestamp(data, 'lastClickedAt');
    }

    function isValidClickUpdate() {
      return request.resource.data.bookId == resource.data.bookId &&
             (!('id' in resource.data) || !('id' in request.resource.data) ||
              request.resource.data.id == resource.data.id) &&
             (!('clicks' in resource.data) || !('clicks' in request.resource.data) ||
              request.resource.data.clicks >= resource.data.clicks) &&
             (!('clickCount' in resource.data) || !('clickCount' in request.resource.data) ||
              request.resource.data.clickCount >= resource.data.clickCount);
    }

    // ===============================================================
    // Domain Validators: author_notes
    // ===============================================================

    function isNoteAuthor(data) {
      return isAuthenticated() &&
        (('authorId' in data) || ('userId' in data)) &&
        (!('authorId' in data) || data.authorId == request.auth.uid) &&
        (!('userId' in data) || data.userId == request.auth.uid);
    }

    function isValidAuthorNote(data) {
      let allowedFields = [
        'id', 'noteId', 'authorId', 'userId', 'title',
        'content', 'notes', 'bookId', 'tags', 'createdAt',
        'updatedAt', 'lastSaved'
      ];

      return hasOnlyAllowedFields(data, allowedFields) &&
             (('authorId' in data && isValidString(data.authorId, 1, 128)) ||
              ('userId' in data && isValidString(data.userId, 1, 128))) &&
             isValidOptionalString(data, 'id', 1, 128) &&
             isValidOptionalString(data, 'noteId', 1, 128) &&
             isValidOptionalString(data, 'title', 0, 200) &&
             isValidOptionalString(data, 'content', 0, 50000) &&
             isValidOptionalString(data, 'notes', 0, 50000) &&
             isValidOptionalString(data, 'bookId', 1, 100) &&
             isValidOptionalList(data, 'tags', 20) &&
             isValidOptionalTimestamp(data, 'createdAt') &&
             isValidOptionalTimestamp(data, 'updatedAt') &&
             isValidOptionalTimestamp(data, 'lastSaved');
    }

    function areNoteImmutableFieldsUnchanged() {
      return (!('authorId' in resource.data) ||
              ('authorId' in request.resource.data && request.resource.data.authorId == resource.data.authorId)) &&
             (!('userId' in resource.data) ||
              ('userId' in request.resource.data && request.resource.data.userId == resource.data.userId)) &&
             (!('id' in resource.data) ||
              ('id' in request.resource.data && request.resource.data.id == resource.data.id)) &&
             (!('noteId' in resource.data) ||
              ('noteId' in request.resource.data && request.resource.data.noteId == resource.data.noteId)) &&
             (!('createdAt' in resource.data) ||
              ('createdAt' in request.resource.data && request.resource.data.createdAt == resource.data.createdAt));
    }

    // ===============================================================
    // Collection Rules
    // ===============================================================

    // 1. manuscripts_catalog
    // Public read for archival manuscript catalog; authenticated write for library authors/administrators
    match /manuscripts_catalog/{bookId} {
      allow read: if true;
      allow create: if isAuthenticated() &&
                       isValidManuscript(request.resource.data);
      allow update: if isAuthenticated() &&
                       isValidManuscript(request.resource.data) &&
                       areManuscriptImmutableFieldsUnchanged();
      allow delete: if isAuthenticated();
    }

    // 2. reader_clicks
    // Public read and reader telemetry writes to track manuscript popularity metrics
    match /reader_clicks/{clickDocId} {
      allow read: if true;
      allow create: if isValidClickTelemetry(request.resource.data);
      allow update: if isValidClickTelemetry(request.resource.data) &&
                       isValidClickUpdate();
      allow delete: if false; // Readers cannot delete library interaction telemetry
    }

    // 3. author_notes
    // Private codex research notes: strictly scoped to the authenticated author
    match /author_notes/{noteId} {
      allow read, delete: if isNoteAuthor(resource.data);
      allow create: if isNoteAuthor(request.resource.data) &&
                       isValidAuthorNote(request.resource.data);
      allow update: if isNoteAuthor(resource.data) &&
                       isNoteAuthor(request.resource.data) &&
                       isValidAuthorNote(request.resource.data) &&
                       areNoteImmutableFieldsUnchanged();
    }

    // ===============================================================
    // Default Deny Rule for All Other Paths
    // ===============================================================
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
