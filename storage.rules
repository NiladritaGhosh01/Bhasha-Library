rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    // Archival manuscripts and covers are publicly readable for all library patrons
    match /manuscripts/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    match /covers/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Default fallback: allow read for public content, write requires authentication
    match /{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }
  }
}
